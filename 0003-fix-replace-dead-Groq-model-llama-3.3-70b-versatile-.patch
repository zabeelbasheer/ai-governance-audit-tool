From 747b98d1f09ff0cb57bdd3cd90c60c069f5a40e3 Mon Sep 17 00:00:00 2001
From: zabeelbasheer <53309631+zabeelbasheer@users.noreply.github.com>
Date: Sat, 22 Aug 2026 17:00:14 +0000
Subject: [PATCH 3/3] fix: replace dead Groq model llama-3.3-70b-versatile with
 openai/gpt-oss-120b

Groq deprecated llama-3.3-70b-versatile for free/developer accounts,
shut down August 16 2026. Updated the hardcoded fallback default in
vendor_detector.py, evaluator.py, mentor_agent.py, and intake_agent.py,
plus .env.example. The live fix is still the MODEL_NAME env var on
Render, this only covers the code-level default.
---
 .env.example       | 2 +-
 evaluator.py       | 2 +-
 intake_agent.py    | 2 +-
 mentor_agent.py    | 2 +-
 vendor_detector.py | 2 +-
 5 files changed, 5 insertions(+), 5 deletions(-)

diff --git a/.env.example b/.env.example
index 7dffb4b..6421ed1 100644
--- a/.env.example
+++ b/.env.example
@@ -1,5 +1,5 @@
 GROQ_API_KEY=your_groq_key_here
-MODEL_NAME=llama-3.3-70b-versatile
+MODEL_NAME=openai/gpt-oss-120b
 
 # main.py (FastAPI) — set a real random value in production
 SESSION_SECRET=change_this_to_a_random_string
diff --git a/evaluator.py b/evaluator.py
index 55eb513..dd22911 100644
--- a/evaluator.py
+++ b/evaluator.py
@@ -75,7 +75,7 @@ def evaluate_criterion(client: Groq, use_case: str, criterion: dict,
                        vendor_name: str = None) -> dict:
     try:
         response = client.chat.completions.create(
-            model=os.getenv("MODEL_NAME", "llama-3.3-70b-versatile"),
+            model=os.getenv("MODEL_NAME", "openai/gpt-oss-120b"),
             messages=[
                 {"role": "system", "content": SYSTEM_PROMPT},
                 {"role": "user",   "content": build_user_prompt(
diff --git a/intake_agent.py b/intake_agent.py
index 267a3fa..0940418 100644
--- a/intake_agent.py
+++ b/intake_agent.py
@@ -53,7 +53,7 @@ def get_client():
 
 
 def get_model():
-    return os.getenv("MODEL_NAME", "llama-3.3-70b-versatile")
+    return os.getenv("MODEL_NAME", "openai/gpt-oss-120b")
 
 
 def build_vendor_context(vendor_key: str = None) -> str:
diff --git a/mentor_agent.py b/mentor_agent.py
index 5f73627..6deddc6 100644
--- a/mentor_agent.py
+++ b/mentor_agent.py
@@ -45,7 +45,7 @@ def get_client():
 
 
 def get_model():
-    return os.getenv("MODEL_NAME", "llama-3.3-70b-versatile")
+    return os.getenv("MODEL_NAME", "openai/gpt-oss-120b")
 
 
 def get_mentor_opening(criterion: dict, use_case: str) -> str:
diff --git a/vendor_detector.py b/vendor_detector.py
index 0545117..1f34e4c 100644
--- a/vendor_detector.py
+++ b/vendor_detector.py
@@ -38,7 +38,7 @@ def detect_vendor_llm(use_case: str) -> dict:
     try:
         client = Groq(api_key=os.getenv("GROQ_API_KEY"))
         response = client.chat.completions.create(
-            model=os.getenv("MODEL_NAME", "llama-3.3-70b-versatile"),
+            model=os.getenv("MODEL_NAME", "openai/gpt-oss-120b"),
             messages=[
                 {"role": "system", "content": DETECTION_PROMPT},
                 {"role": "user",   "content": f"Use case:\n{use_case}"},
