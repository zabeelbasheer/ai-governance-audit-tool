+/* ── New audit flow ─────────────────────────────────────────────────────── */
+
+const newAuditView = document.getElementById('new-audit-view');
+const stageDescribe   = document.getElementById('stage-describe');
+const stageIntake     = document.getElementById('stage-intake');
+const stageEvaluating = document.getElementById('stage-evaluating');
+const stageResults    = document.getElementById('stage-results');
+
+let currentSessionId = null;
+let evalPollTimer = null;
+
+function showStage(stage) {
+  [stageDescribe, stageIntake, stageEvaluating, stageResults].forEach(s => s.classList.add('hidden'));
+  stage.classList.remove('hidden');
+}
+
+async function openNewAuditView() {
+  dashboardView.classList.add('hidden');
+  newAuditView.classList.remove('hidden');
+  currentSessionId = null;
+  document.getElementById('audit-title').value = '';
+  document.getElementById('audit-usecase').value = '';
+  document.getElementById('audit-start-error').classList.add('hidden');
+  showStage(stageDescribe);
+
+  const vendorSelect = document.getElementById('audit-vendor');
+  vendorSelect.innerHTML = '<option value="">Auto-detect from description</option>';
+  try {
+    const data = await api('api/vendors');
+    data.vendors.filter(v => v.key).forEach(v => {
+      const opt = document.createElement('option');
+      opt.value = v.key;
+      opt.textContent = v.label;
+      vendorSelect.appendChild(opt);
+    });
+  } catch { /* vendor list is a nice-to-have, don't block the form on it */ }
+}
+
+function closeNewAuditView() {
+  clearInterval(evalPollTimer);
+  newAuditView.classList.add('hidden');
+  dashboardView.classList.remove('hidden');
+  loadSessions();
+}
+
+document.getElementById('new-audit-btn').addEventListener('click', openNewAuditView);
+document.getElementById('audit-back-btn').addEventListener('click', closeNewAuditView);
+document.getElementById('audit-signout-btn').addEventListener('click', async () => {
+  await api('api/logout', { method: 'POST' });
+  location.reload();
+});
+
+function addChatBubble(role, text) {
+  const thread = document.getElementById('chat-thread');
+  const div = document.createElement('div');
+  div.className = 'chat-bubble ' + role;
+  div.textContent = text;
+  thread.appendChild(div);
+  thread.scrollTop = thread.scrollHeight;
+}
+
+document.getElementById('start-audit-btn').addEventListener('click', async () => {
+  const errEl = document.getElementById('audit-start-error');
+  errEl.classList.add('hidden');
+  const useCase = document.getElementById('audit-usecase').value.trim();
+  if (!useCase) {
+    errEl.textContent = 'Describe the use case before starting.';
+    errEl.classList.remove('hidden');
+    return;
+  }
+  const title = document.getElementById('audit-title').value.trim();
+  const vendorKey = document.getElementById('audit-vendor').value || null;
+
+  try {
+    const data = await api('api/audits', {
+      method: 'POST',
+      body: JSON.stringify({ title, use_case: useCase, vendor_key: vendorKey }),
+    });
+    currentSessionId = data.session_id;
+
+    document.getElementById('chat-thread').innerHTML = '';
+    const tagEl = document.getElementById('intake-vendor-tag');
+    tagEl.innerHTML = data.vendor_display
+      ? `<span class="vendor-tag">Vendor detected: ${escapeHtml(data.vendor_display)}</span>`
+      : '';
+    addChatBubble('assistant', data.question);
+    document.getElementById('intake-answer').value = '';
+    showStage(stageIntake);
+  } catch (err) {
+    errEl.textContent = err.message;
+    errEl.classList.remove('hidden');
+  }
+});
+
+async function sendIntakeAnswer() {
+  const input = document.getElementById('intake-answer');
+  const answer = input.value.trim();
+  if (!answer || !currentSessionId) return;
+  addChatBubble('user', answer);
+  input.value = '';
+
+  try {
+    const data = await api(`api/audits/${currentSessionId}/intake`, {
+      method: 'POST',
+      body: JSON.stringify({ answer }),
+    });
+    if (data.complete) {
+      addChatBubble('assistant', 'Got what I need. Starting the governance evaluation now.');
+      startEvaluation();
+    } else {
+      addChatBubble('assistant', data.question);
+    }
+  } catch (err) {
+    addChatBubble('assistant', `Something went wrong: ${err.message}`);
+  }
+}
+
+document.getElementById('intake-send-btn').addEventListener('click', sendIntakeAnswer);
+document.getElementById('intake-answer').addEventListener('keydown', e => {
+  if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendIntakeAnswer(); }
+});
+
+async function startEvaluation() {
+  showStage(stageEvaluating);
+  document.getElementById('eval-progress-bar').style.width = '0%';
+  document.getElementById('eval-progress-label').textContent = 'Starting…';
+  document.getElementById('eval-progress-current').textContent = '';
+
+  await api(`api/audits/${currentSessionId}/evaluate`, { method: 'POST' });
+
+  evalPollTimer = setInterval(async () => {
+    try {
+      const p = await api(`api/audits/${currentSessionId}/evaluate/progress`);
+      const pct = p.total ? Math.round((p.done / p.total) * 100) : 0;
+      document.getElementById('eval-progress-bar').style.width = pct + '%';
+      document.getElementById('eval-progress-label').textContent = `${p.done} of ${p.total} criteria evaluated`;
+      document.getElementById('eval-progress-current').textContent = p.current || '';
+
+      if (p.complete) {
+        clearInterval(evalPollTimer);
+        if (p.error) {
+          document.getElementById('eval-progress-label').textContent = 'Evaluation failed, see current status for details.';
+        } else {
+          const full = await api(`api/audits/${currentSessionId}`);
+          renderResults(full);
+          showStage(stageResults);
+        }
+      }
+    } catch {
+      clearInterval(evalPollTimer);
+    }
+  }, 1500);
+}
+
+function scoreColor(score) {
+  if (score <= 2) return '#c0392b';
+  if (score === 3) return '#e67e22';
+  return '#27ae60';
+}
+
+function renderResults(full) {
+  const s = full.session;
+  document.getElementById('results-score-num').textContent = s.overall_pct != null ? `${s.overall_pct}%` : '—';
+  const bandEl = document.getElementById('results-band');
+  bandEl.textContent = s.maturity_label || '—';
+  bandEl.style.background = s.maturity_color || 'var(--sky)';
+  document.getElementById('results-desc').textContent = s.maturity_desc || '';
+
+  const groups = {};
+  full.results.forEach(r => {
+    if (!groups[r.function]) groups[r.function] = [];
+    groups[r.function].push(r);
+  });
+
+  const html = Object.entries(groups).map(([fn, rows]) => `
+    <div class="function-group">
+      <div class="function-label">${escapeHtml(fn)}</div>
+      ${rows.map(r => `
+        <div class="criterion-row">
+          <div class="criterion-top">
+            <div>
+              <div class="criterion-name">${escapeHtml(r.criterion_name)}</div>
+              <div class="criterion-framework">${escapeHtml(r.criterion_id)}</div>
+            </div>
+            <span class="score-badge" style="background:${scoreColor(r.score)}">${r.score} / 5</span>
+          </div>
+          <div class="criterion-rationale">${escapeHtml(r.rationale)}</div>
+          ${r.remediation ? `<div class="criterion-remediation">Remediation: ${escapeHtml(r.remediation)}</div>` : ''}
+        </div>
+      `).join('')}
+    </div>
+  `).join('');
+
+  document.getElementById('results-groups').innerHTML = html;
+}
+
+async function openExistingAudit(id) {
+  try {
+    const full = await api(`api/audits/${id}`);
+    dashboardView.classList.add('hidden');
+    newAuditView.classList.remove('hidden');
+    currentSessionId = id;
+    if (full.session.status === 'intake') {
+      document.getElementById('results-groups').innerHTML =
+        '<div class="empty-state">This audit was never finished, intake was never completed. Start a new audit instead.</div>';
+      document.getElementById('results-score-num').textContent = '—';
+      document.getElementById('results-band').textContent = 'Incomplete';
+      document.getElementById('results-band').style.background = 'var(--sky)';
+      document.getElementById('results-desc').textContent = '';
+      showStage(stageResults);
+    } else {
+      renderResults(full);
+      showStage(stageResults);
+    }
+  } catch (err) {
+    alert(`Couldn't open that audit: ${err.message}`);
+  }
+}
+
 checkSession();
 </script>
 </body>
