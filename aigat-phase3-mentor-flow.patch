+/* ── Mentor flow ────────────────────────────────────────────────────────── */
+
+function renderMentorProgress(index, total) {
+  document.getElementById('mentor-progress').textContent = `Gap ${index + 1} of ${total}`;
+}
+
+function renderMentorCriterion(criterion) {
