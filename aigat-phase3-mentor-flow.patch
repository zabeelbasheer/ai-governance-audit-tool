+        </div>
+        <span class="score-badge" style="background:${scoreColor(criterion.score)}">${criterion.score} / 5</span>
+      </div>
+    </div>`;
+}
+
+function showMentorInput(show) {
+  document.getElementById('mentor-input-row').classList.toggle('hidden', !show);
+  document.getElementById('mentor-done-wrap').classList.toggle('hidden', show);
+}
+
+document.getElementById('start-mentoring-btn').addEventListener('click', async () => {
+  try {
+    const data = await api(`api/audits/${currentSessionId}/mentor/start`, { method: 'POST' });
+    if (data.done) {
+      alert('No red or amber findings on this audit, nothing to mentor on.');
+      return;
+    }
+    document.getElementById('mentor-thread').innerHTML = '';
+    renderMentorProgress(data.index, data.total);
+    renderMentorCriterion(data.criterion);
+    addChatBubble('assistant', data.message, 'mentor-thread');
+    showMentorInput(true);
+    document.getElementById('mentor-answer').value = '';
+    showStage(stageMentor);
+  } catch (err) {
+    alert(`Couldn't start mentoring: ${err.message}`);
+  }
+});
+
+async function sendMentorAnswer() {
+  const input = document.getElementById('mentor-answer');
+  const answer = input.value.trim();
+  if (!answer) return;
+  addChatBubble('user', answer, 'mentor-thread');
+  input.value = '';
+
+  try {
+    const data = await api(`api/audits/${currentSessionId}/mentor/answer`, {
+      method: 'POST',
+      body: JSON.stringify({ answer }),
+    });
+
+    if (data.closing_message) addChatBubble('assistant', data.closing_message, 'mentor-thread');
+    if (data.action_item) {
+      addChatBubble('assistant', `Action: ${data.action_item.action}${data.action_item.owner ? ' (owner: ' + data.action_item.owner + ')' : ''}, due ${data.action_item.due_date}.`, 'mentor-thread');
+    }
+
+    if (data.done) {
+      showMentorInput(false);
+      return;
+    }
+
+    renderMentorProgress(data.index, data.total);
+    renderMentorCriterion(data.criterion);
+    addChatBubble('assistant', data.message, 'mentor-thread');
+  } catch (err) {
+    addChatBubble('assistant', `Something went wrong: ${err.message}`, 'mentor-thread');
+  }
+}
+
+document.getElementById('mentor-send-btn').addEventListener('click', sendMentorAnswer);
+document.getElementById('mentor-answer').addEventListener('keydown', e => {
+  if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendMentorAnswer(); }
+});
