From 8d5fc2f455727dfa88fbbd5a801ba99b6360d6db Mon Sep 17 00:00:00 2001
From: zabeelbasheer <53309631+zabeelbasheer@users.noreply.github.com>
Date: Sun, 23 Aug 2026 15:25:13 +0000
Subject: [PATCH] perf: parallelize the 24-criterion evaluation across a
 bounded thread pool

Sequential calls were taking 3+ minutes in practice. Each evaluate_criterion
call is independent, so this runs up to 6 concurrently, each with its own
Groq client rather than sharing one across threads. Results are reassembled
in original criteria order regardless of completion order, verified with a
mocked test before trusting it against the real API: order preserved, all
24 present, progress counted correctly with no race condition.

Also fix: the intake/mentor answer textarea was 44px tall, forcing constant
scrolling for the kind of detailed answers the evaluator actually rewards.
Now 140px and resizable.
---
 evaluator.py | 40 ++++++++++++++++++++++++++--------------
 index.html   |  4 ++--
 2 files changed, 28 insertions(+), 16 deletions(-)

diff --git a/evaluator.py b/evaluator.py
index 39d90c0..a3a151d 100644
--- a/evaluator.py
+++ b/evaluator.py
@@ -8,6 +8,8 @@ deployment-specific context.
 
 import json
 import os
+from concurrent.futures import ThreadPoolExecutor, as_completed
+from threading import Lock
 from groq import Groq
 from criteria import CRITERIA, MATURITY_BANDS
 from dotenv import load_dotenv
@@ -123,8 +125,6 @@ def run_evaluation(use_case: str, progress_callback=None,
     """
     from vendor_kb import VENDOR_KB, get_baseline_scores
 
-    client   = get_client()
-    results  = []
     baselines = {}
     vendor_name = None
 
@@ -135,20 +135,32 @@ def run_evaluation(use_case: str, progress_callback=None,
     else:
         vendor_cov = {}
 
-    for i, criterion in enumerate(CRITERIA):
-        cid             = criterion["id"]
-        vendor_baseline = baselines.get(cid)
-        vendor_note     = vendor_cov.get(cid, {}).get("note")
-
-        result = evaluate_criterion(
-            client, use_case, criterion,
-            vendor_baseline=vendor_baseline,
-            vendor_note=vendor_note,
+    results_by_id = {}
+    completed = 0
+    progress_lock = Lock()
+
+    def _run_one(criterion):
+        cid = criterion["id"]
+        # Each task gets its own client rather than sharing one across threads.
+        return criterion, evaluate_criterion(
+            get_client(), use_case, criterion,
+            vendor_baseline=baselines.get(cid),
+            vendor_note=vendor_cov.get(cid, {}).get("note"),
             vendor_name=vendor_name,
         )
-        results.append(result)
-        if progress_callback:
-            progress_callback(i + 1, len(CRITERIA), criterion["name"])
+
+    with ThreadPoolExecutor(max_workers=6) as pool:
+        futures = [pool.submit(_run_one, c) for c in CRITERIA]
+        for future in as_completed(futures):
+            criterion, result = future.result()
+            results_by_id[criterion["id"]] = result
+            with progress_lock:
+                completed += 1
+                if progress_callback:
+                    progress_callback(completed, len(CRITERIA), criterion["name"])
+
+    # Reassemble in the original criteria order, not completion order.
+    results = [results_by_id[c["id"]] for c in CRITERIA]
 
     total_weighted = sum(r["weighted_score"] for r in results)
     max_weighted   = sum(c["weight"] * 5 for c in CRITERIA)
diff --git a/index.html b/index.html
index 3e88a9f..4c371a9 100644
--- a/index.html
+++ b/index.html
@@ -234,8 +234,8 @@ textarea.field-input { resize: vertical; min-height: 90px; font-family: inherit;
 .chat-bubble.assistant { background: var(--parchment); color: var(--midnight); align-self: flex-start; border: 1px solid var(--border); }
 .chat-bubble.user { background: var(--navy); color: var(--white); align-self: flex-end; }
 
-.chat-input-row { display: flex; gap: 8px; }
-.chat-input-row textarea { flex: 1; min-height: 44px; }
+.chat-input-row { display: flex; gap: 8px; align-items: flex-end; }
+.chat-input-row textarea { flex: 1; min-height: 140px; resize: vertical; }
 
 .progress-wrap { text-align: center; padding: 40px 20px; }
 .progress-bar-outer { background: var(--border); border-radius: 20px; height: 8px; overflow: hidden; margin: 16px 0 10px; }
