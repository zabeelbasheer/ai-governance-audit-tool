+    s["score_num"] = ParagraphStyle("score", fontSize=26, leading=31, textColor=MIDNIGHT, fontName="Helvetica-Bold")
+    s["band"] = ParagraphStyle("band", fontSize=10, leading=13, textColor=WHITE,
