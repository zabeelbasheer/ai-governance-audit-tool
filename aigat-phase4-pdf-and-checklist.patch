+/* ── Cross-audit checklist view ─────────────────────────────────────────── */
+
+async function saveChecklistItem(id, status, owner, dueDate) {
+  await api(`api/checklist/${id}`, {
+    method: 'PATCH',
+    body: JSON.stringify({ status, owner, due_date: dueDate }),
+  });
+}
+
+function renderChecklistView(data) {
+  document.getElementById('checklist-heading').textContent = data.can_view_all
+    ? 'Remediation action items, all audits'
+    : 'Remediation action items, your audits';
+
+  const wrap = document.getElementById('checklist-view-table-wrap');
+  if (!data.items.length) {
+    wrap.innerHTML = '<div class="empty-state">No action items yet. They show up here once you run mentoring on a scored audit.</div>';
+    return;
+  }
+
+  const rows = data.items.map(it => `
+    <tr data-item-id="${it.id}">
+      <td>
+        <div class="cell-title">${escapeHtml(it.action)}</div>
+        <div class="cell-sub">${escapeHtml(it.audit_title)}${it.audit_owner_name ? ' · ' + escapeHtml(it.audit_owner_name) : ''}</div>
+      </td>
+      <td><input class="field-input checklist-owner" style="margin-bottom:0; padding:6px 8px; font-size:12px;" value="${escapeHtml(it.owner || '')}" placeholder="Unassigned"></td>
+      <td><input type="date" class="field-input checklist-due" style="margin-bottom:0; padding:6px 8px; font-size:12px;" value="${escapeHtml(it.due_date || '')}"></td>
+      <td>
+        <select class="field-input checklist-status" style="margin-bottom:0; padding:6px 8px; font-size:12px;">
+          <option value="pending" ${it.status === 'pending' ? 'selected' : ''}>Pending</option>
+          <option value="in_progress" ${it.status === 'in_progress' ? 'selected' : ''}>In progress</option>
+          <option value="done" ${it.status === 'done' ? 'selected' : ''}>Done</option>
+        </select>
+      </td>
+    </tr>
+  `).join('');
+
+  wrap.innerHTML = `<table>
+    <thead><tr><th>Action item</th><th>Owner</th><th>Due</th><th>Status</th></tr></thead>
+    <tbody>${rows}</tbody>
+  </table>`;
+
+  wrap.querySelectorAll('tr[data-item-id]').forEach(row => {
+    const id = row.dataset.itemId;
+    const ownerInput = row.querySelector('.checklist-owner');
+    const dueInput = row.querySelector('.checklist-due');
+    const statusSelect = row.querySelector('.checklist-status');
+
+    const save = async () => {
+      try {
+        await saveChecklistItem(id, statusSelect.value, ownerInput.value, dueInput.value);
+      } catch (err) {
+        alert(`Couldn't save: ${err.message}`);
+      }
+    };
+    ownerInput.addEventListener('blur', save);
+    dueInput.addEventListener('change', save);
+    statusSelect.addEventListener('change', save);
+  });
+}
+
+async function loadChecklistView() {
+  const data = await api('api/checklist');
+  renderChecklistView(data);
+}
+
+document.getElementById('view-checklist-btn').addEventListener('click', () => {
+  dashboardView.classList.add('hidden');
+  document.getElementById('checklist-view').classList.remove('hidden');
+  loadChecklistView();
+});
+
+document.getElementById('checklist-back-btn').addEventListener('click', () => {
+  document.getElementById('checklist-view').classList.add('hidden');
+  dashboardView.classList.remove('hidden');
+  loadSessions(document.getElementById('search-input').value);
+});
+
+document.getElementById('checklist-signout-btn').addEventListener('click', async () => {
+  await api('api/logout', { method: 'POST' });
+  location.reload();
+});
